{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eczane Nobet",
  "mainBinaryName": "eczane-nobet",
  "version": "1.0.0",
  "identifier": "tr.hastane.eczane.nobet",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Nöbet Çizelgesi Yönetim Sistemi",
        "width": 1320,
        "height": 880,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "publisher": "Hastane Eczanesi",
    "shortDescription": "Nöbet çizelgesi",
    "longDescription": "Hastane eczanesi nöbet ve puantaj çizelgesi: veriler ortak klasörde şifreli, kullanıcı adı ve şifreyle giriş.",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish"],
        "displayLanguageSelector": false
      }
    }
  }
}
